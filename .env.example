DATABASE_URL="postgresql://postgres:your-db-password@127.0.0.1:5432/new_crm?schema=public"

# Auth / login
CRM_ADMIN_EMAIL="admin@crm.com"
CRM_ADMIN_MOBILE="01700000001"
CRM_ADMIN_PASSWORD="change-this-admin-password"
NEXT_PUBLIC_CRM_ADMIN_EMAIL="admin@crm.com"
NEXT_PUBLIC_CRM_ADMIN_MOBILE="01700000001"
CRM_SHOW_LOGIN_OTP="false"

# Email / notifications
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"
EMAIL_FROM="no-reply@example.com"
AUTH_EMAIL_REDIRECT_TO="https://crm.example.com"

# Optional local/dev utilities
CRM_ENABLE_DEMO_SEED="false"
